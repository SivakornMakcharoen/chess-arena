# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง

# พอร์ตที่ backend จะรัน
PORT=3001

# โดเมนของ frontend ที่อนุญาตให้เรียก API นี้ (CORS) คั่นด้วย comma ได้หลายโดเมน
FRONTEND_ORIGIN=http://localhost:5173

# กุญแจลับสำหรับเซ็น JWT — เปลี่ยนเป็นค่าสุ่มยาวๆ ก่อนใช้งานจริงเด็ดขาด
# สร้างได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
# กุญแจ "apikey" แบบง่ายๆ ที่ frontend จะแนบมาด้วยทุก request (กันบอทสุ่มยิง API เล่นๆ)
# ไม่ใช่ระบบรักษาความปลอดภัยระดับสูง แค่ชั้นกรองเบื้องต้น ตั้งเป็นค่าอะไรก็ได้ที่คาดเดายาก
API_KEY=change-this-too
