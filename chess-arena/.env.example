# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
#
# URL ของ backend ตัวเอง (โฟลเดอร์ backend/ ในโปรเจกต์นี้) ไม่ใช่ Supabase แล้ว
# ตอน dev ท้องถิ่น (รัน backend ด้วย `npm run dev` ที่พอร์ต 3001):
VITE_API_URL=http://localhost:3001
# ตอน deploy จริง เปลี่ยนเป็น URL จริงของ backend เช่น https://api.yourdomain.com

# ต้องตรงกับค่า API_KEY ที่ตั้งไว้ใน backend/.env
VITE_API_KEY=change-this-too

# Vite เปิดเผยเฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_ ให้โค้ดฝั่ง client เท่านั้น
# และ .env ถูกใส่ไว้ใน .gitignore แล้ว ค่าจริงจะไม่ถูก commit ขึ้น git
